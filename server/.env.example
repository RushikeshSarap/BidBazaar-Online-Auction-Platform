# Environment variables for BidBazaar Online Auction Platform
# Copy this file to .env and replace the placeholder values before running the server.

# JWT secret used for token verification
JWT_SECRET=your_jwt_secret_here

# PostgreSQL database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=auction_platform

# Application settings
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=replace_with_a_random_secret

# Cloudinary image storage (configure before enabling hosted uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay payments (configure before enabling payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local demo accounts created by `npm run seed`; choose a private local password
SEED_USER_PASSWORD=replace_with_a_unique_local_seed_password
